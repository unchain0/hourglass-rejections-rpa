# Hourglass Rejections RPA - Environment Configuration
# Copy to .env and fill required values (never commit .env)

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Telegram Bot Configuration
# Get token from @BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID of the only administrator (get it from /whoami or @userinfobot).
# Additional users are managed from the bot with /allow <chat_id> and /deny <chat_id>.
TELEGRAM_WHITELIST=123456789

# Required by Docker Compose for the bundled PostgreSQL service.
# Use a strong, unique value and keep the same value across restarts.
POSTGRES_PASSWORD=replace_with_a_strong_unique_password

# =============================================================================
# TOKEN CONFIGURATION (VPS/Server Deployment)
# =============================================================================

# Option 1: First-start automatic renewal bootstrap (recommended)
# Copy one currently valid pair from Hourglass browser DevTools.
# The daemon registers a WebAuthn credential from this session and then renews
# independently. Persist ~/.hourglass-rpa (or the paths below) across deploys.
HOURGLASS_XSRF_TOKEN=your_token_here
HOURGLASS_HGLOGIN_COOKIE=your_cookie_here

# Files created by the first-start bootstrap, or manually by make setup-auth.
TOKENS_PATH=/home/user/.hourglass-rpa/auth-tokens.json
WEBAUTHN_CREDENTIALS_PATH=/home/user/.hourglass-rpa/webauthn-credentials.json

# Option 2: Persistent Chrome profile for Google/interactive session reuse
# Optional fallback for cases where you want to reuse the same browser profile too.
# First authenticate locally with make setup-auth or make save-tokens
# and keep the same browser profile directory mounted on the server/VPS.
# CHROME_PROFILE_DIR=/home/user/.hourglass-rpa/chrome-profile

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# API endpoint (default: https://app.hourglass-app.com)
# HOURGLASS_URL=https://app.hourglass-app.com

# Database backend (default: sqlite for local development)
# When running via Docker Compose, PostgreSQL is provided automatically and
# DATABASE_URL is optional. POSTGRES_PASSWORD above is required by Compose.
# Set DB_TYPE=postgres to use an external PostgreSQL database directly, or
# provide DATABASE_URL for an external database.
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=hourglass
# DB_PASSWORD=replace_with_a_strong_unique_password
# For one upgrade only, set this to the password stored in an existing volume.
# Remove it after db-password-migrate completes successfully.
# POSTGRES_OLD_PASSWORD=existing_database_password
# DB_NAME=hourglass
# DB_SSLMODE=disable
# DATABASE_URL=postgres://user:password@host:5432/postgres
# SQLITE_DB_PATH=data/hourglass.db

# Timezone (default: America/Sao_Paulo)
TZ=America/Sao_Paulo

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# =============================================================================
# ADVANCED: Token Refresh Configuration
# =============================================================================

# Enable automatic token refresh inside the main daemon (default: true)
# The daemon also retries once after Hourglass returns 401/unauthorized.
# AUTO_REFRESH_TOKENS=true

# Optional: cadence for the standalone token-refresh utility / sidecar
# REFRESH_INTERVAL=6h

# =============================================================================
# OPENTELEMETRY (Optional but recommended)
# =============================================================================

# OTLP/HTTP receiver endpoint on your collector or backend
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer token,stream-name=default
# OTEL_SERVICE_NAME=hourglass-rejections-rpa
# OTEL_SERVICE_VERSION=1.0.0
# DEPLOYMENT_ENVIRONMENT=production
